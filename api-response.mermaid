    Find@{ label: "<div style=\"width:280px; text-align:left;\"><b>Findability: object</b><br>• <i>title:</i> \"Findability\"<br>• <i>display_name:</i> \"Findability\"<br>• <i>description:</i> \"Assessment of how...\"<br>• <i>type:</i> \"object\"<br>• persistentIdentifier<br>• richMetadata<br>• indexedInSearchEngines<br>• metadataSchema<br>• metadataPersistence</div>" }
    Root@{ label: "<div style=\"width:280px; text-align:left;\"><b>Root: DataRepository</b><br>• @context (Schema.org)<br>• @id / url (URIs)<br>• identifier (ID)<br>• name<br>• metadataStandard</div>" }
    Access@{ label: "<div style=\"width:280px; text-align:left;\"><b>accessibility: object</b><br>• <i>title:</i> \"Accessibility\"<br>• <i>display_name:</i> \"Accessibility\"<br>• <i>description:</i> \"Assessment of how...\"<br>• <i>type:</i> \"object\"<br>• retrievalProtocol<br>• authenticationRequired<br>• authenticationType<br>• metadataAlwaysAvailable<br>• dataAvailability</div>" }
    Inter@{ label: "<div style=\"width:280px; text-align:left;\"><b>interoperability: object</b><br>• <i>title:</i> \"Interoperability\"<br>• <i>display_name:</i> \"Interoperability\"<br>• <i>description:</i> \"Assessment of how...\"<br>• <i>type:</i> \"object\"<br>• knowledgeRepresentation<br>• vocabulariesUsed<br>• qualifiedReferences<br>• dataFormats<br>• apiAvailability</div>" }
    Date@{ label: "<div style=\"width:280px; text-align:left;\"><b>assessmentDate</b><br>• value: null / \"YYYY-MM-DD\"<br>• type: \"string\"</div>" }
    Method@{ label: "<div style=\"width:280px; text-align:left;\"><b>assessmentMethod</b><br>• value: null<br>• type: \"string\"</div>" }
