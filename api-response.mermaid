flowchart LR
    Reuse@{ label: "<div style=\"width:280px; text-align:left;\"><b>reusability: object</b><br>• <i>title:</i> \"Reusability\"<br>• <i>display_name:</i> \"Reusability\"<br>• <i>description:</i> \"Assessment of how...\"<br>• <i>type:</i> \"object\"<br>• licenseClarity<br>• provenanceInfo<br>• communityStandards<br>• documentationQuality<br>• <b>citationGuidelines [Focus]</b></div>" } -. Detailed Schema .-> FocusNode@{ label: "<div style=\"width:280px; text-align:left;\"><b>❝ Focus Property Detail</b><br><i>citationGuidelines</i><br>• <b>value:</b> false<br>• <b>type:</b> \"boolean\"<br>• <b>title:</b> \"Citation Guidelines\"<br>• <b>display_name:</b> \"Citation Guidelines\"<br>• <b>description:</b> \"Clear citation guidelines ensure proper attribution and reproducibility...\"<br>• <b>additional_information:</b> \"Confirms explicit inclusion of sample reference text, BibTeX handles...\"<br>• <b>placeholder:</b> \"Toggle if structured tracking reference snippets...\"</div>" }
